+// Controls share the exact row layout/virtual scroll as the source text.
+// Coordinates come from the consumer's canonical patch model, not display hunk IDs.
+fn hunk_control_for_row<'a>(
+    controls: &'a [HunkControl],
+    row: &DiffAlignedRow,
+) -> Option<&'a HunkControl> {
+    if row.kind == DiffRowKind::Equal {
+        return None;
+    }
+    controls.iter().find(|control| match (row.left, row.right) {
+        (Some(left), Some(right)) => left == control.old_start && right == control.new_start,
+        (Some(left), None) => left == control.old_start,
+        (None, Some(right)) => right == control.new_start,
+        _ => false,
+    })
+}
+
+fn hunk_gutter(
+    control: Option<&HunkControl>,
+    config: &DiffViewerConfig,
+    events: &PrimitiveContext,
+    disabled: bool,
+) -> AnyElement {
+    let mut gutter = div()
+        .w(px(48.0))
+        .flex_shrink_0()
+        .h_full()
+        .flex()
+        .items_center()
+        .gap(px(4.0))
+        .px(px(3.0));
+    if let Some(control) = control {
+        for (action, label) in [
+            ("restore", "»"),
+            ("toggle", if control.checked { "✓" } else { "" }),
+        ] {
+            let events = events.clone();
+            let left = config.left.source.text();
+            let right = config.right.source.text();
+            let path = config.right.file_name.clone().unwrap_or_default();
+            let index = control.index;
+            let mut button = div()
+                .id(SharedString::from(format!(
+                    "hunk-{}-{action}",
+                    control.index
+                )))
+                .w(px(18.0))
+                .h(px(18.0))
+                .flex_shrink_0()
+                .flex()
+                .items_center()
+                .justify_center()
+                .text_size(px(14.0))
+                .text_color(rgba(0xc9d1d9ff))
+                .rounded(px(2.0))
+                .child(label);
+            if action == "toggle" {
+                button = button.border_1().border_color(rgba(0x9099a6ff));
+            }
+            if !disabled {
+                button = button
+                    .cursor_pointer()
+                    .hover(|s| s.bg(rgba(0x45556fff)))
+                    .on_mouse_down(MouseButton::Left, |_, _, cx| cx.stop_propagation())
+                    .on_click(move |_, window, cx| {
+                        cx.stop_propagation();
+                        let events = events.clone();
+                        let payload = UiValue::Map(BTreeMap::from([
+                            ("action".into(), UiValue::String(action.into())),
+                            ("index".into(), UiValue::Integer(index as i64)),
+                            ("path".into(), UiValue::String(path.clone())),
+                            ("left".into(), UiValue::String(left.to_string())),
+                            ("right".into(), UiValue::String(right.to_string())),
+                        ]));
+                        window.defer(cx, move |window, cx| {
+                            let _ = events.emit("hunk_action", payload, window, cx);
+                        });
+                    });
+            }
+            gutter = gutter.child(button);
+        }
+    }
+    gutter.into_any_element()
+}
