+// Source byte ranges, independent of rendered tabs, wrapping and diff prefixes.
+fn selection_unit_range(source: &str, offset: usize, unit: SelectionUnit) -> Range<usize> {
+    let offset = clamp_char_boundary(source, offset);
+    match unit {
+        SelectionUnit::Character => offset..offset,
+        SelectionUnit::Line => {
+            let start = source[..offset].rfind('\n').map_or(0, |i| i + 1);
+            let end = source[offset..]
+                .find('\n')
+                .map_or(source.len(), |i| offset + i + 1);
+            start..end
+        }
+        SelectionUnit::Word => {
+            let probe = if offset == source.len() {
+                source.char_indices().next_back().map_or(0, |(i, _)| i)
+            } else {
+                offset
+            };
+            source
+                .split_word_bound_indices()
+                .find(|(start, text)| *start <= probe && probe < *start + text.len())
+                .map_or(offset..offset, |(start, text)| start..start + text.len())
+        }
+    }
+}
